{
  "name": "zyrax-forum",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node build_dashboard_worker.cjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create cloudforum-db",
    "d1:init:local": "wrangler d1 execute cloudforum-db --local --file=./schema/d1.sql",
    "d1:init:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/d1.sql",
    "d1:migrate:auth-plus:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/migration_auth_plus.sql",
    "d1:migrate:post-views:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/migration_post_views.sql",
    "d1:migrate:register-email-codes:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/migration_register_email_codes.sql",
    "d1:migrate:security:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/migration_security.sql",
    "d1:migrate:user-presence:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/migration_user_presence.sql"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
